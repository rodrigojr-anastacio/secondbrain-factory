[Unit]
Description=Fábrica YouTube — palavras-chave em alta → sugestões de vídeo e canal (Claude pela API — Agent SDK, créditos do Max; sem Hermes)
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/workspace/fabrica-youtube/tools/rotinas/palavras-chave.sh
TimeoutStartSec=2h
