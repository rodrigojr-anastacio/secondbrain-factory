[Unit]
Description=Fábrica YouTube — produção noturna: pré-voo + pauta do backlog vivo + fila (tools/rotinas/noturna.sh planejar)
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/workspace/fabrica-youtube/tools/rotinas/noturna.sh planejar
TimeoutStartSec=20min
