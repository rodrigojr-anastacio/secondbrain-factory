30d50a656f816b336f414af70ae40906f8403f45","length":"2552.45","height":"240","width":"320"},{"name":"gov.doe.0800002_archive.torrent","source":"metadata","btih":"712846bb87ab09fb96bc366672cc2853a2e2ff5f","mtime":"1665559807","size":"35543","md5":"88ded592cb9e0f1b7a8d55b5083500f9","crc32":"b3b60573","sha1":"b806177975042ea576dc0ceb1f707ebe85566829","format":"Archive BitTorrent"},{"name":"gov.doe.0800002_files.xml","source":"metadata","format":"Metadata","md5":"78eaa138891e54cc1dac17eee86bb090","summation":"md5"},{"name":"gov.doe.0800002_meta.xml","source":"metadata","format":"Metadata","mtime":"1462485432","size":"1522","md5":"a8041c92cac24c564c0eb853a5174226","crc32":"ec3cbb9f","sha1":"75cb7a21f345fe8e6145865e9a6ef3e6120026c8"},{"name":"gov.doe.0800002_reviews.xml","source":"original","mtime":"1723278618","size":"2670","format":"Metadata","md5":"e977ebbfabc753f238e95b12c8c9e925","crc32":"e2423dfb","sha1":"02b59099f1ca58df852cf1c196cb896393136ffc"}],"files_count":53,"item_last_updated":1723278618,"item_size":3451494658,"metadata":{"identifier":"gov.doe.0800002","title":"Nuclear Test Film - Project Crossroads","creator":"Department of Energy","mediatype":"movies","collection":["FedFlix","usgovfilms","newsandpublicaffairs"],"description":"Department of Energy<br /><br />TF 0800002 doe.gov<br /><br />Nuclear Test Film - Project Crossroads<br /><br /><br /><br />DVD Copied by The Department of Energy, in cooperation with the Department of Defense, declassified a series of historical films on the nuclear weapons program. They were converted to videotape format to help preserve the films and to facilitate the declassification and release process. These films document the history of the development of nuclear weapons, starting with the first bomb tested at Trinity Site in southeastern New Mexico in July 1945..","subject":"doe.gov;public.resource.org","licenseurl":"http://creativecommons.org/publicdomain/zero/1.0/","publicdate":"2010-05-18 16:30:47","addeddate":"2010-05-18 16:30:47","uploader":"carl@media.org","sound":"sound","color":"color","credits":"Uploaded by Public.Resource.Org","language":"English","updatedate":"2010-05-18 23:13:34","updater":"malamud","backup_location":"ia903605_16"},"reviews":[{"reviewbody":"You have some great films in this nuclear test collection but please - pump up the volume!  Thanks.","reviewtitle":"Not a silent film","reviewer":"hrsauertieg","reviewdate":"2015-05-28 02:20:40","createdate":"2015-05-28 02:20:40","stars":"4"},{"reviewtitle":"Original film copy","reviewbody":"Thank you very much for uploading this footage. In the text it says that the films were converted to videotape, do you have an insight on if there is an 35 or 16mm print copy of the film available? I can\u2019t seem to find where exactly these films are stored, if you would be able to bring me in contact with the organization or archivist that has more knowledge on this film that would be great.\n\nWarm wishes,\nLuna\n\n ","stars":"4","reviewer":"luna hupperetz","reviewdate":"2022-10-12 07:30:01","createdate":"2022-10-12 07:30:01","reviewer_itemname":"@luna_hupperetz"},{"reviewtitle":"Questioning the significance of the shapes we find in the mushroom clouds","reviewbody":"Every explosion is unique to itself. No two are exactly the same. Other than the environmental factors (wetness of air, the land, the temp outside etc) could one suppose their are emotional factors as well? \nIf an atomic blast is that reactive, surly it is reacting with things humans can't consciously perceive as factors?\nSuch as the energy our bodies put out, the energy of collective thoughts/feelings that manifest themselves into the particles as they rain down, or the mushroom clouds' shape being influenced by our gaze alone.\n\nOf course everyone, after the fact, is going to project their own perceptions onto the clouds' shapes and what they see after the fact. \"I see a face\" \"I see God's disappointment\"\nBUT what is the bomb actually saying based in real time?\n\nObjectively its a cloud of poisonous radiation, but it was still manifested by a chemical reaction that caused combustion. So, there must must have physical factors influenced by what's floating in the air from everyone.","stars":"0","reviewer":"Ponian Reinventedhorsechild","reviewdate":"2024-08-10 08:30:14","createdate":"2024-08-10 08:30:14","reviewer_itemname":"@ponian_reinventedhorsechild"}],"server":"dn801208.us.archive.org","simplelists":{"solo_manifest":{"solo_manifest_dn801208":{"sys_changed_by":{"source":"task","task_id":"5463229099"},"sys_last_changed":"2026-06-24 12:35:39.946817"}}},"solo":true,"uniq":193848694,"workable_servers":["dn801208.us.archive.org"]}