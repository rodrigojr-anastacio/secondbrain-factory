 l’échelle"}, {"t": 368.37100000000004, "kind": "img", "pid": "P15", "img": "gen_umbar", "kb": [1.05, 1.22, 0.6, 0.5, 0.6, 0.5], "kw": ["Umbar", "Le repaire des Corsaires"], "from": 11051, "dur": 203, "credit": "Illustration générée · originale"}, {"t": 375.1260000000001, "kind": "img", "pid": "P15", "img": "gen_pelargir", "kb": [1.18, 1.18, 0.6, 0.5, 0.4, 0.5], "kw": ["Pelargir", "Grand port du Gondor"], "from": 11254, "dur": 95, "credit": "Illustration générée · originale"}, {"t": 378.30500000000006, "kind": "map", "pid": "P15", "view": "south", "sunk": true, "show": ["minas_tirith", "osgiliath", "umbar", "pelargir"], "hl": ["minas_tirith"], "fade": ["osgiliath"], "from": 11349, "dur": 168, "credit": "Carte schématique originale · pas à l’échelle"}, {"t": 383.91100000000006, "kind": "recap", "pid": "P16", "steps": [{"at": 45, "a": "Premier Âge", "b": "Gondolin"}, {"at": 102, "a": "Deuxième Âge", "b": "Khazad-dûm"}, {"at": 161, "a": "Troisième Âge", "b": "Osgiliath → Minas Tirith"}, {"at": 250, "a": "Toute Arda", "b": "?"}], "from": 11517, "dur": 429}, {"t": 398.21100000000007, "kind": "card", "title": "Toute Arda", "sub": "Au-delà de la Terre du Milieu", "from": 11946, "dur": 75}, {"t": 400.6910000000001, "kind": "map", "pid": "P17", "view": "arda", "sunk": true, "show": ["minas_tirith", "khazad", "armenelos"], "numenor": true, "from": 12021, "dur": 154, "credit": "Carte schématique originale · pas à l’échelle"}, {"t": 405.8390000000001, "kind": "img", "pid": "P17", "img": "gen_tirion", "kb": [1.05, 1.22, 0.5, 0.45, 0.5, 0.45], "kw": ["Tirion", "Aman — aucune donnée"], "from": 12175, "dur": 175, "credit": "Illustration générée · originale"}, {"t": 411.6570000000001, "kind": "img", "pid": "P17", "img": "friedrich_eismeer", "kb": [1.18, 1.05, 0.5, 0.5, 0.5, 0.5], "grade": "dim", "from": 12350, "dur": 192, "credit": "Caspar David Friedrich · domaine public"}, {"t": 418.0690000000001, "kind": "map", "pid": "P18", "view": "numenor", "sunk": true, "numenor": true, "show": ["armenelos"], "hl": ["armenelos"], "crown": "armenelos", "kw": null, "from": 12542, "dur": 151, "credit": "Carte schématique originale · pas à l’échelle"}, {"t": 423.0930000000001, "kind": "img", "pid": "P18", "img": "cole_consummation", "kb": [1.0, 1.15, 0.5, 0.5, 0.5, 0.5], "from": 12693, "dur": 108, "credit": "Thomas Cole · domaine public"}, {"t": 426.6910000000001, "kind": "img", "pid": "P18", "img": "lorrain_ursula", "kb": [1.18, 1.05, 0.5, 0.5, 0.5, 0.5], "from": 12801, "dur": 156, "credit": "Claude Lorrain · domaine public"}, {"t": 431.8910000000001, "kind": "map", "pid": "P18", "view": "arda", "sunk": true, "numenor": true, "show": ["armenelos", "umbar", "pelargir"], "fleet_from": "armenelos", "fleet_to": ["umbar", "pelargir", "lindon"], "from": 12957, "dur": 181, "credit": "Carte schématique originale · pas à l’échelle"}, {"t": 437.9220000000001, "kind": "img", "pid": "P18", "img": "gen_armenelos", "kb": [1.0, 1.12, 0.5, 0.5, 0.5, 0.5], "contain": true, "kw": ["Armenelos", "Cœur de Númenor"], "from": 13138, "dur": 72, "credit": "Illustration générée · originale"}, {"t": 440.33600000000007, "kind": "img", "pid": "P18", "img": "turner_dido", "kb": [1.05, 1.22, 0.5, 0.45, 0.5, 0.45], "from": 13210, "dur": 195, "credit": "J. M. W. Turner · domaine public"}, {"t": 446.83400000000006, "kind": "map", "pid": "P18b", "view": "numenor", "sunk": true, "numenor": true, "show": ["armenelos"], "hl": ["armenelos"], "kw": null, "from": 13405, "dur": 286, "credit": "Carte schématique originale · pas à l’échelle"}, {"t": 456.37800000000004, "kind": "img", "pid": "P19", "img": "danby_deluge", "kb": [1.05, 1.22, 0.5, 0.5, 0.5, 0.5], "from": 13691, "dur": 158, "credit": "Francis Danby · domaine public"}, {"t": 461.61800000000005, "kind": "img", "pid": "P19", "img": "aivazovsky_wave", "kb": [1.18, 1.18, 0.35, 0.5, 0.6, 0.5], "kw": ["Akallabêth", "la Submergée"], "from": 13849, "dur": 131, "credit": "Ivan Aïvazovski · domaine public"}, {"t": 465.98400000000004, "kind": "map", "pid": "P19", "view": "numenor", "sunk": true, "numenor": true, "show": ["armenelos"], "sink_numenor": true, "from": 13980, "dur": 95, "credit": "Carte schématique originale · pas à l’échelle"}, {"t": 469.17600000000004, "kind": "map", "pid": "P19", "view": "arda", "sunk": true, "numenor": true, "numenor_gone": true, "show": ["osgiliath", "minas_tirith", "annuminas"], "fleet_from": "numenor_wreck", "fleet_to": ["lindon", "pelargir"], "kw": null, "from": 14075, "dur": 176, "credit": "Carte schématique originale · pas à l’échelle"}, {"t": 475.033, "kind": "img", "pid": "P19", "img": "schinkel_river", "kb": [1.05, 1.22, 0.5, 0.5, 0.5, 0.5], "from": 14251, "dur": 103, "credit": "Karl Friedrich Schinkel · domaine public"}, {"t": 478.48, "kind": "img", "pid": "P20", "img": "friedrich_wanderer", "kb": [1.0, 1.1, 0.5, 0.35, 0.5, 0.35], "contain": true, "from": 14354, "dur": 157, "credit": "Caspar David Friedrich · domaine public"}, {"t": 483.697, "kind": "recap", "pid": "P20", "final": true, "steps": [{"at": 6, "a": "Gondolin", "b": ""}, {"at": 27, "a": "Khazad-dûm", "b": ""}, {"at": 48, "a": "Osgiliath", "b": ""}, {"at": 69, "a": "Armenelos", "b": ""}], "from": 14511, "dur": 156}, {"t": 488.90500000000003, "kind": "img", "pid": "P20", "img": "friedrich_wanderer", "kb": [1.0, 1.1, 0.5, 0.3, 0.5, 0.3], "contain": true, "kw": ["En commentaire", "Quelle ville mérite la couronne ?"], "from": 14667, "dur": 139, "credit": "Caspar David Friedrich · domaine public"}, {"t": 493.52500000000003, "kind": "end", "from": 14806, "dur": 147}], "crown": [{"from": 2131, "name": "Les Falas", "era": "Premier Âge"}, {"from": 2506, "name": "Nogrod · Belegost", "era": "Premier Âge"}, {"from": 3043, "name": "Menegroth", "era": "Premier Âge"}, {"from": 3882, "name": "Nargothrond", "era": "Premier Âge"}, {"from": 5245, "name": "Gondolin", "era": "Premier Âge"}, {"from": 6412, "name": "Khazad-dûm", "era": "Deuxième Âge"}, {"from": 8196, "name": "Osgiliath", "era": "Troisième Âge"}, {"from": 10237, "name": "Minas Tirith", "era": "Troisième Âge"}, {"from": 12542, "name": "Armenelos", "era": "Toute Arda"}], "captions": [{"from": 24, "to": 123, "text": "Minas Tirith, la cité blanche adossée à la montagne."}, {"from": 127, "to": 198, "text": "Khazad-dûm, l'immense royaume des Nains."}, {"from": 202, "to": 309, "text": "Osgiliath, la capitale coupée en deux par le Grand Fleuve."}, {"from": 313, "to": 375, "text": "Umbar, le repaire des corsaires."}, {"from": 379, "to": 427, "text": "Ces noms, vous les connaissez."}, {"from": 431, "to": 475, "text": "Mais il y a un piège."}, {"from": 479, "to": 591, "text": "On les découvre presque toujours au pire moment de leur histoire."}, {"from": 595, "to": 654, "text": "Minas Tirith à moitié vide."}, {"from": 658, "to": 702, "text": "La Moria abandonnée."}, {"from": 706, "to": 752, "text": "Osgiliath en ruines."}, {"from": 770, "to": 866, "text": "Alors, quelle a été la plus grande ville de la Terre du Milieu ?"}, {"from": 875, "to": 915, "text": "Et à quelle époque ?"}, {"from": 924, "to": 999, "text": "Tolkien ne donne presque jamais de chiffres."}, {"from": 1003, "to": 1044, "text": "Pas de recensement."}, {"from": 1048, "to": 1175, "text": "Alors on va estimer, avec ce que les textes permettent vraiment de dire."}, {"from": 1179, "to": 1258, "text": "Et quand c'est une estimation, je vous le dirai."}, {"from": 1261, "to": 1388, "text": "On va suivre une couronne, qui passe d'une cité à l'autre au fil des Âges."}, {"from": 1392, "to": 1457, "text": "Et la plus grande cité de toute Arda…"}, {"from": 1466, "to": 1517, "text": "je vous la révèle à la fin."}, {"from": 1613, "to": 1723, "text": "Commençons au Premier Âge, sur la côte ouest du Beleriand."}, {"from": 1727, "to": 1780, "text": "Avant même le retour des Noldor,"}, {"from": 1781, "to": 1911, "text": "Círdan et les Elfes de la mer y tiennent deux ports : Brithombar et Eglarest,"}, {"from": 1912, "to": 1956, "text": "les Havres des Falas."}, {"from": 1960, "to": 2017, "text": "Des remparts, des quais, des navires."}, {"from": 2021, "to": 2131, "text": "Ce sont parmi les plus anciennes villes dont on connaisse le nom."}, {"from": 2134, "to": 2245, "text": "Mais ce sont des ports de pêcheurs et de marins, pas des capitales."}, {"from": 2249, "to": 2335, "text": "La couronne ne restera pas longtemps sur la côte."}, {"from": 2353, "to": 2467, "text": "Car à l'est, dans les Montagnes Bleues, les Nains ont creusé deux cités :"}, {"from": 2468, "to": 2505, "text": "Nogrod et Belegost."}, {"from": 2509, "to": 2603, "text": "Elles sont célèbres dans tout le Beleriand pour leurs forges,"}, {"from": 2604, "to": 2672, "text": "leurs armes et leurs cottes de mailles."}, {"from": 2676, "to": 2719, "text": "Combien d'habitants ?"}, {"from": 2728, "to": 2774, "text": "Aucune source ne le dit."}, {"from": 2778, "to": 2903, "text": "Mais ce ne sont pas des villages : ce sont des royaumes entiers, sous la roche."}, {"from": 2921, "to": 3063, "text": "C'est d'ailleurs avec l'aide des Nains de Belegost que le roi Thingol fait creuser"}, {"from": 3065, "to": 3181, "text": "Menegroth, les Mille Cavernes, au cœur de la forêt de Doriath."}, {"from": 3185, "to": 3234, "text": "Un palais qui est aussi une ville,"}, {"from": 3235, "to": 3319, "text": "avec des salles taillées comme des forêts de pierre."}, {"from": 3323, "to": 3450, "text": "Les textes en parlent comme de la plus belle demeure de roi à l'est de la mer."}, {"from": 3454, "to": 3547, "text": "Mais Menegroth ne tombe pas sous les coups de Morgoth."}, {"from": 3551, "to": 3603, "text": "Elle tombe à cause d'un joyau."}, {"from": 3607, "to": 3695, "text": "Pour un Silmaril, les Nains de Nogrod la pillent."}, {"from": 3699, "to": 3760, "text": "Puis les fils de Fëanor l'achèvent."}, {"from": 3778, "to": 3929, "text": "Plus à l'ouest, Finrod Felagund fonde Nargothrond, en s'inspirant de Menegroth,"}, {"from": 3930, "to": 3999, "text": "dans les gorges du fleuve Narog."}, {"from": 4003, "to": 4068, "text": "Une forteresse creusée dans la falaise,"}, {"from": 4069, "to": 4152, "text": "assez peuplée pour lever une véritable armée."}, {"from": 4156, "to": 4204, "text": "Sa force, c'est le secret."}, {"from": 4208, "to": 4254, "text": "Puis le secret disparaît."}, {"from": 4258, "to": 4381, "text": "On bâtit un grand pont devant les portes, on choisit la guerre ouverte…"}, {"from": 4390, "to": 4458, "text": "et le dragon Glaurung franchit ce pont."}, {"from": 4462, "to": 4587, "text": "Nargothrond est pillée, son peuple massacré ou emmené en captivité."}, {"from": 4605, "to": 4745, "text": "Mais si une ville devait porter la couronne du Premier Âge, ce serait Gondolin."}, {"from": 4749, "to": 4798, "text": "La cité cachée du roi Turgon,"}, {"from": 4799, "to": 4945, "text": "bâtie sur une colline au milieu d'une plaine fermée par un cercle de montagnes."}, {"from": 4949, "to": 5005, "text": "Des siècles de construction."}, {"from": 5009, "to": 5087, "text": "Un peuple qui grandit à l'abri de toute guerre."}, {"from": 5091, "to": 5169, "text": "Et une ville que Tolkien décrit avec ses tours,"}, {"from": 5170, "to": 5245, "text": "ses fontaines et ses portes successives."}, {"from": 5249, "to": 5330, "text": "Pour la taille, c'est notre meilleure candidate."}, {"from": 5334, "to": 5403, "text": "Mais attention : c'est une estimation."}, {"from": 5407, "to": 5504, "text": "Tolkien décrit sa beauté, pas le nombre de ses habitants."}, {"from": 5508, "to": 5553, "text": "Et elle tombe, elle aussi."}, {"from": 5556, "to": 5670, "text": "Trahie par Maeglin, elle est assaillie par des dragons et des Balrogs."}, {"from": 5688, "to": 5833, "text": "À la fin du Premier Âge, la Guerre de la Colère brise le pouvoir de Morgoth."}, {"from": 5837, "to": 5971, "text": "Mais le prix est terrible : presque tout le Beleriand est englouti par la mer."}, {"from": 5975, "to": 6106, "text": "Gondolin, Nargothrond, Menegroth, les ports des Falas, les cités naines…"}, {"from": 6115, "to": 6164, "text": "tout disparaît, ou presque."}, {"from": 6168, "to": 6227, "text": "La couronne doit partir vers l'est."}, {"from": 6323, "to": 6412, "text": "Au Deuxième Âge, elle se pose sous les Monts Brumeux."}, {"from": 6416, "to": 6479, "text": "Khazad-dûm, la demeure de Durin."}, {"from": 6483, "to": 6544, "text": "Après la ruine des Montagnes Bleues,"}, {"from": 6545, "to": 6642, "text": "des Nains de Nogrod et de Belegost viennent la rejoindre,"}, {"from": 6644, "to": 6712, "text": "avec leur savoir et leur artisanat."}, {"from": 6716, "to": 6844, "text": "Puis vient l'amitié avec les Elfes d'Eregion, et le commerce du mithril."}, {"from": 6848, "to": 6911, "text": "Khazad-dûm devient riche comme jamais."}, {"from": 6914, "to": 7021, "text": "Les textes la présentent comme la plus grande des demeures naines."}, {"from": 7024, "to": 7092, "text": "Des salles immenses, des niveaux superposés,"}, {"from": 7094, "to": 7173, "text": "des galeries qui traversent toute la montagne."}, {"from": 7177, "to": 7292, "text": "À la surface de la Terre du Milieu, rien ne lui ressemble encore."}, {"from": 7310, "to": 7408, "text": "Mais un autre peuple arrive par la mer : les Númenóréens."}, {"from": 7412, "to": 7512, "text": "D'abord des escales, puis des ports, puis des forteresses."}, {"from": 7516, "to": 7618, "text": "Au sud, Umbar devient un grand port et une place forte."}, {"from": 7622, "to": 7743, "text": "Près de l'embouchure de l'Anduin, Pelargir devient le port des Fidèles."}, {"from": 7747, "to": 7859, "text": "Ces villes grandissent vite, portées par une flotte et par un empire."}, {"from": 7863, "to": 7958, "text": "Elles sont sans doute les plus actives de toute la côte."}, {"from": 7962, "to": 8018, "text": "Mais détrôner Khazad-dûm ?"}, {"from": 8027, "to": 8104, "text": "Rien dans les textes ne permet de l'affirmer."}, {"from": 8200, "to": 8284, "text": "Au Troisième Âge, la couronne passe aux Hommes."}, {"from": 8287, "to": 8354, "text": "Osgiliath, la Citadelle des Étoiles,"}, {"from": 8356, "to": 8462, "text": "fondée par les fils d'Elendil et capitale du Gondor."}, {"from": 8465, "to": 8561, "text": "Construite des deux côtés de l'Anduin, reliée par un pont,"}, {"from": 8562, "to": 8641, "text": "avec son grand dôme et sa pierre de vision."}, {"from": 8645, "to": 8702, "text": "Au sommet de la puissance du Gondor,"}, {"from": 8703, "to": 8832, "text": "c'est très probablement la plus grande ville des Hommes en Terre du Milieu."}, {"from": 8835, "to": 8911, "text": "Probablement : là encore, aucun chiffre."}, {"from": 8929, "to": 8989, "text": "Mais Osgiliath ne meurt pas d'un coup."}, {"from": 8993, "to": 9034, "text": "Elle s'éteint lentement."}, {"from": 9038, "to": 9148, "text": "La guerre civile, la Lutte fratricide, l'incendie en partie."}, {"from": 9152, "to": 9210, "text": "La Grande Peste la dépeuple."}, {"from": 9214, "to": 9304, "text": "Le roi quitte la ville et s'installe à Minas Anor."}, {"from": 9308, "to": 9426, "text": "Puis, des siècles plus tard, les Orques du Mordor achèvent de la ruiner."}, {"from": 9430, "to": 9545, "text": "Quand Frodo naît, Osgiliath n'est déjà plus qu'un champ de bataille."}, {"from": 9563, "to": 9602, "text": "Et Khazad-dûm ?"}, {"from": 9611, "to": 9676, "text": "Pendant tout ce temps, elle tient toujours."}, {"from": 9680, "to": 9785, "text": "Elle a traversé le Deuxième Âge et la guerre contre Sauron."}, {"from": 9789, "to": 9908, "text": "Jusqu'au jour où les Nains creusent trop profond, à la recherche du mithril,"}, {"from": 9909, "to": 9997, "text": "et réveillent ce qu'on appellera le Fléau de Durin."}, {"from": 10001, "to": 10055, "text": "Deux rois tombent, coup sur coup."}, {"from": 10059, "to": 10101, "text": "Le peuple s'enfuit."}, {"from": 10105, "to": 10151, "text": "La Moria se vide."}, {"from": 10169, "to": 10236, "text": "Alors la couronne monte sur la montagne."}, {"from": 10240, "to": 10390, "text": "Minas Anor, la Tour du Soleil, rebaptisée Minas Tirith, la Tour de Garde."}, {"from": 10394, "to": 10497, "text": "Sept niveaux, sept portes, une citadelle de pierre blanche."}, {"from": 10501, "to": 10609, "text": "Elle restera la capitale du Gondor jusqu'à la fin de l'Âge."}, {"from": 10612, "to": 10711, "text": "Mais au moment où nous la découvrons dans Le Seigneur des Anneaux,"}, {"from": 10712, "to": 10768, "text": "elle n'a jamais paru aussi vide."}, {"from": 10772, "to": 10849, "text": "Tolkien le dit lui-même : la ville est en déclin,"}, {"from": 10850, "to": 10976, "text": "et il lui manque une bonne partie des gens qui pourraient y vivre à l'aise."}, {"from": 10994, "to": 11051, "text": "Au sud, Umbar change de mains."}, {"from": 11055, "to": 11183, "text": "Prise par le Gondor, puis perdue au profit des descendants du rebelle Castamir,"}, {"from": 11184, "to": 11253, "text": "elle devient le repaire des Corsaires."}, {"from": 11257, "to": 11349, "text": "Pelargir, elle, reste le grand port du royaume."}, {"from": 11353, "to": 11422, "text": "Deux villes riches, actives, stratégiques…"}, {"from": 11431, "to": 11503, "text": "mais toujours dans l'ombre de la capitale."}, {"from": 11521, "to": 11559, "text": "Récapitulons."}, {"from": 11563, "to": 11616, "text": "Au Premier Âge, Gondolin."}, {"from": 11620, "to": 11674, "text": "Au Deuxième, Khazad-dûm."}, {"from": 11678, "to": 11764, "text": "Au Troisième, Osgiliath, puis Minas Tirith."}, {"from": 11768, "to": 11835, "text": "Mais il manque quelqu'un dans ce classement."}, {"from": 11839, "to": 11928, "text": "Une ville qui ne se trouve même pas en Terre du Milieu."}, {"from": 12024, "to": 12088, "text": "Car la question de départ, c'était aussi :"}, {"from": 12089, "to": 12170, "text": "quelle est la plus grande ville de toute Arda ?"}, {"from": 12179, "to": 12275, "text": "On pourrait penser à Tirion, la cité des Elfes en Aman,"}, {"from": 12276, "to": 12349, "text": "perchée sur sa colline face à la mer."}, {"from": 12353, "to": 12439, "text": "Mais là, les textes ne donnent rien de mesurable."}, {"from": 12443, "to": 12528, "text": "Impossible d'estimer quoi que ce soit honnêtement."}, {"from": 12546, "to": 12649, "text": "Ma réponse, c'est Armenelos, la cité royale de Númenor."}, {"from": 12653, "to": 12692, "text": "Pensez-y."}, {"from": 12696, "to": 12800, "text": "Une île entière, donnée aux Hommes, en paix pendant des siècles."}, {"from": 12804, "to": 12870, "text": "Une marine capable de traverser l'océan,"}, {"from": 12871, "to": 12994, "text": "de fonder des ports sur toute la côte de la Terre du Milieu, et, à la fin,"}, {"from": 12996, "to": 13137, "text": "de mettre en marche la plus grande flotte jamais vue contre les Valar eux-mêmes."}, {"from": 13141, "to": 13210, "text": "Armenelos est le cœur de cette puissance."}, {"from": 13214, "to": 13339, "text": "Aucun royaume de la Terre du Milieu n'a jamais concentré autant d'hommes,"}, {"from": 13340, "to": 13391, "text": "de richesse et de savoir."}, {"from": 13409, "to": 13517, "text": "Tolkien n'a jamais publié de chiffre officiel pour Armenelos."}, {"from": 13521, "to": 13577, "text": "Mais à l'échelle d'une île entière,"}, {"from": 13578, "to": 13677, "text": "aucune ville de la Terre du Milieu ne pouvait rivaliser."}, {"from": 13695, "to": 13765, "text": "Et sa chute est la plus totale de toutes."}, {"from": 13768, "to": 13806, "text": "Pas un siège."}, {"from": 13810, "to": 13848, "text": "Pas un incendie."}, {"from": 13852, "to": 13919, "text": "L'île entière, engloutie par les flots."}, {"from": 13923, "to": 13979, "text": "Akallabêth, la Submergée."}, {"from": 13983, "to": 14075, "text": "De la plus grande ville d'Arda, il ne reste rien."}, {"from": 14079, "to": 14207, "text": "Seulement la mémoire des survivants, et les royaumes qu'ils fondent en exil :"}, {"from": 14208, "to": 14251, "text": "l'Arnor et le Gondor."}, {"from": 14255, "to": 14340, "text": "Avec, justement, Osgiliath et Minas Tirith."}, {"from": 14358, "to": 14403, "text": "Voilà ma réponse."}, {"from": 14407, "to": 14511, "text": "Mais c'est une estimation, et vous avez peut-être la vôtre."}, {"from": 14515, "to": 14604, "text": "Gondolin, Khazad-dûm, Osgiliath, Armenelos…"}, {"from": 14613, "to": 14662, "text": "ou une autre que j'ai oubliée ?"}, {"from": 14671, "to": 14795, "text": "Dites-moi en commentaire quelle ville mérite vraiment la couronne, et pourquoi."}]}