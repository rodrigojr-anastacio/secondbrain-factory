# cerebro-fabrica: só texto, código e conhecimento. Mídia e segredos ficam fora.

# --- Mídia (qualquer pasta) ---
*.mp4
*.mov
*.mkv
*.avi
*.wav
*.mp3
*.flac
*.m4a
*.aac
*.ogg
*.opus
*.webm
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.tif
*.tiff
*.psd
*.svg.gz
*.zip
*.tar
*.tar.gz
*.7z
*.pdf
*.srt
*.vtt
*.ttf
*.otf
*.woff
*.woff2

# --- Pastas de saída e mídia ---
**/out/*
**/out-*/*
!**/out/*.md
!**/out/*.txt
!**/out-*/*.md
!**/out-*/*.txt
imagens/
imagens-*/
audio/
audio-*/
ref/
dl/
build/
public/
thumb-var/
thumbs-v2/
**/qa/*
**/qa-*/*
!**/qa/*.md
!**/qa-*/*.md
logs/
pesquisa/tendencias/assets/

# --- Dependências e caches ---
node_modules/
.venv/
venv/
__pycache__/
*.pyc
.cache/
.remotion/
*.log

# --- Segredos (nunca versionar) ---
.env
.env.*
*.env
.segredos
.segredos/
*secret*
*credential*
*token*.json
tokens/
client_secret*.json
*.pem
*.key

# --- Exceções: thumbnails finais publicadas e material da base de conhecimento (< 500 KB cada) ---
!conhecimento/
!conhecimento/**

# --- Skills vendorizadas dentro de projetos de vídeo (reinstaláveis via skills-lock.json) ---
canais/*/videos/*/.agents/
canais/*/videos/*/.claude/

# --- Exceção: as skills do Produtor são texto (skills/imagens/ casaria com a regra imagens/) ---
!skills/imagens/
!skills/imagens/**
